{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempo",
  "version": "0.1.0",
  "identifier": "app.tempo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tempo",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http: https: ws: wss: data: asset:; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http: https: http://asset.localhost; connect-src 'self' http: https: ws: wss: https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      }
    }
  }
}
